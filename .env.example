APP_NAME="Polo Rainbow"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://polorainbow.com.br
ALLOW_TEST_CPFS=false

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=polo_rainbow
DB_USERNAME=...
DB_PASSWORD=...
DB_CHARSET=utf8mb4

MAIL_DRIVER=smtp
MAIL_ENABLED=false
MAIL_QUEUE_PROCESSING=true
MAIL_FROM_EMAIL=no-reply@polorainbow.com.br
MAIL_FROM_NAME="Polo Rainbow"
MAIL_REPLY_TO=no-reply@polorainbow.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

SESSION_NAME=POLO_RAINBOW
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_SAME_SITE=Lax

LOG_LEVEL=info
