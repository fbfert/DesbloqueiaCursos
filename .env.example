APP_NAME="Desbloqueia Cursos"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://polorainbow.com.br
# APP_KEY é obrigatória para criptografar segredos no banco. O painel admin usa o .env como fallback.
APP_KEY=

# Configuração de pagamento. O administrador pode sobrescrever estes valores pela área administrativa.
ALLOW_TEST_CPFS=false
ABACATEPAY_ENABLED=false
ABACATEPAY_MODE=dev
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_URL_SECRET=
ABACATEPAY_ENVIRONMENT=sandbox
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2

# Integração com o Claude / Anthropic
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TEMPERATURE=0.2
ANTHROPIC_TIMEOUT=30

# Norminha IA V1 — OpenAI Responses API (POST /v1/responses)
#
# DESLIGADA POR PADRAO. Nao habilite sem, antes:
#   1. HARD CAP DE GASTO configurado no painel da OpenAI. O rate limit da
#      aplicacao e codigo novo, sem historico em producao; o limite do provedor
#      e a ultima linha entre um bug e a fatura.
#   2. Politica de privacidade do portal refletindo o envio de contexto de aluno
#      a operador estrangeiro.
#
# OPENAI_MODEL vai VAZIO de proposito: o modelo padrao do plano mestre (gpt-4.1)
# nao consta mais na lista de modelos atuais da OpenAI. Confirme na documentacao
# oficial e preencha. Consultado em 23/08/2026, os modelos correntes eram:
#   gpt-5.6-luna   US$ 0,20 / US$ 1,20 por milhao de tokens (entrada/saida)
#   gpt-5.6-terra  US$ 2,00 / US$ 12,00
#   gpt-5.6-sol    US$ 4,00 / US$ 20,00
# Preco e disponibilidade mudam: reconfira no dia da habilitacao.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT=30
OPENAI_STORE=false

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=polo_rainbow
DB_USERNAME=...
DB_PASSWORD=...
DB_CHARSET=utf8mb4

MAIL_DRIVER=smtp
MAIL_ENABLED=false
MAIL_QUEUE_PROCESSING=true
MAIL_FROM_EMAIL=no-reply@polorainbow.com.br
MAIL_FROM_NAME="Desbloqueia Cursos"
MAIL_REPLY_TO=no-reply@polorainbow.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

SESSION_NAME=POLO_RAINBOW
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_SAME_SITE=Lax

LOG_LEVEL=info

# Fase 2.13 — Versão da Home servida na raiz "/". Padrão: v1 (Home V1 ativa).
# Defina HOME_VERSION=v2 para virar a Home ao V2 após homologação manual.
# Reversível: basta voltar para v1. Não remove rotas legadas nem V2.
HOME_VERSION=v1
